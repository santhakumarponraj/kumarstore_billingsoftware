QTabBar::tab {
    background: #E3F2FD;
    color: #0D47A1;
    border: 1px solid #A7C7E7;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    padding: 0px 5px;      /* ⬅️ more padding */
    min-width: 120px;        /* ⬅️ ensures text fits */
    min-height: 15px;        /* ⬅️ gives height for Bookman font */
    font-family: &quot;Bookman Old Style&quot;;
    font-size: 10pt;
    font-weight: 600;
    margin-left: 3px;
    transition: all 0.3s ease;
}

QTabBar::tab:hover {
    background: #BBDEFB;
    color: #0B3C8A;
}

QTabBar::tab:selected {
    background: #90CAF9;
    color: #0A357A;
    font-weight: bold;
    border-color: #7EB7E3;
}

QTabBar::tab:!selected {
    margin-top: 2px;
}

QTabWidget::tab-bar {
    alignment: left;
}

QWidget {
